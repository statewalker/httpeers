{
  "name": "@statewalker/httpeers-core",
  "version": "0.1.0",
  "type": "module",
  "description": "The httpeers handler contract, mount router, peer context, stores and errors. Isomorphic: no libp2p, no wasm, no node: builtins, no DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
