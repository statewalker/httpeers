{
  "name": "@statewalker/httpeers-qr",
  "version": "0.1.1",
  "type": "module",
  "description": "QR for httpeers: encoding and decoding as pure functions, plus a browser entry that scans from the live camera or a picture.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-qr"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {
    "jsqr": "catalog:",
    "qrcode-generator": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "html5-qrcode": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "html5-qrcode": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "html5-qrcode": {
      "optional": true
    }
  }
}
