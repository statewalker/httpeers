{
  "name": "@statewalker/httpeers-access",
  "version": "0.1.3",
  "type": "module",
  "description": "Who is calling, and may they. Biscuit tokens, Datalog policy, revocation and one middleware — with no libp2p in the graph.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-access"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./issuer": {
      "source": "./src/issuer.ts",
      "types": "./dist/issuer.d.ts",
      "import": "./dist/issuer.js"
    },
    "./engine": {
      "source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {
    "@statewalker/httpeers-core": "workspace:^",
    "@statewalker/webrun-biscuit": "workspace:^",
    "multiformats": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@biscuit-auth/biscuit-wasm": "catalog:",
    "@libp2p/crypto": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
