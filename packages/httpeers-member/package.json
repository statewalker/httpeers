{
  "name": "@statewalker/httpeers-member",
  "version": "0.1.5",
  "type": "module",
  "description": "Everything a participant does: hold an identity, redeem or resume, connect, keep the link, advertise, discover, call, and serve.",
  "bugs": {
    "url": "https://github.com/statewalker/httpeers/issues"
  },
  "homepage": "https://github.com/statewalker/httpeers/tree/main/packages/httpeers-member#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-member"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./reset": {
      "source": "./src/reset.ts",
      "types": "./dist/reset.d.ts",
      "import": "./dist/reset.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {
    "@libp2p/crypto": "catalog:",
