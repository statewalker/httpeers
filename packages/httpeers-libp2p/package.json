{
  "name": "@statewalker/httpeers-libp2p",
  "version": "0.1.1",
  "type": "module",
  "description": "The transport: nodes, identity, and servePeer — the one place in the extraction that knows what libp2p is.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-libp2p"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && pnpm run typecheck && vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/circuit-relay-v2": "catalog:",
    "@libp2p/crypto": "catalog:",
    "@libp2p/identify": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/peer-id": "catalog:",
    "@libp2p/tcp": "catalog:",
    "@libp2p/utils": "catalog:",
    "@libp2p/webrtc": "catalog:",
    "@libp2p/websockets": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/httpeers-bridge": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/webrun-http-streams": "catalog:",
    "@statewalker/webrun-streams": "catalog:",
    "@statewalker/webrun-streams-libp2p": "catalog:",
    "libp2p": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@statewalker/httpeers-access": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
