{
  "name": "@statewalker/httpeers-conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every prototype, rebuilt against the published API and judged by tsc. Never published, never depended on -- see the README for why it is its own package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "packages/httpeers-conformance"
  },
  "scripts": {
    "build": "echo \"no build: this package compiles its consumers in its own test\"",
    "test": "pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check tests",
    "lint:check": "biome check tests"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@chainsafe/libp2p-noise": "catalog:",
    "@chainsafe/libp2p-yamux": "catalog:",
    "@libp2p/circuit-relay-v2": "catalog:",
    "@libp2p/crypto": "catalog:",
    "@libp2p/identify": "catalog:",
    "@libp2p/interface": "catalog:",
    "@libp2p/tcp": "catalog:",
    "@libp2p/webrtc": "catalog:",
    "@libp2p/websockets": "catalog:",
    "@multiformats/multiaddr": "catalog:",
    "@statewalker/httpeers-access": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/httpeers-ghost": "workspace:*",
    "@statewalker/httpeers-hub": "workspace:*",
    "@statewalker/httpeers-join": "workspace:*",
    "@statewalker/httpeers-libp2p": "workspace:*",
    "@statewalker/httpeers-member": "workspace:*",
    "@statewalker/httpeers-qr": "workspace:*",
    "@statewalker/httpeers-relay": "workspace:*",
    "@statewalker/webrun-http-proxy": "catalog:",
    "@types/node": "catalog:",
    "libp2p": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
