#!/usr/bin/env bash
#
# Live mode: `rclone serve nfs` on loopback, mounted locally, so the folder IS
# the bucket and there is no publish step at all.
#
# NONE OF THE SAFETY IN httpeers-publish APPLIES INSIDE THIS MOUNT. There is no
# diff, no confirmation and no undo: `rm -rf mnt/abc.httpeers.net` takes the
# site off the internet the moment the last object is gone. That is the point
# of the mode -- "add and remove sites by changing the content of a folder" --
# but it is the reason this script says so every time it runs, and the reason
# sync mode, not this, is the default.
set -euo pipefail
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"

usage() {
  cat >&2 <<'USAGE'
usage: httpeers-mount [--fuse|--nfs] [--sudo] [--read-only] [--foreground]

  Mounts the bucket so the folder IS the bucket. Two transports:

  --fuse        `rclone mount` on this host. No docker and no root. The default
                on Linux.
  --nfs         `rclone serve nfs` in a container on loopback, mounted by the
                host's NFS client. Needs docker, mount.nfs and root. The default
                -- and the only option -- on macOS, where FUSE means macFUSE, a
                kernel extension that has to be installed and approved by hand.

  --sudo        run the `mount` command through sudo. Without it the exact
                command is printed for you to run, because mounting NFS on
                Linux needs root and this script will not acquire root behind
                your back.
  --read-only   serve the bucket read-only. Useful for browsing production.
  --foreground  run the NFS server in the foreground (Ctrl-C stops it); do
                not mount. For debugging the server on its own.

Safe to run twice: an already-running server and an already-mounted point are
detected and left alone.
USAGE
}

use_sudo=0; read_only=0; foreground=0; want_transport=
while [ $# -gt 0 ]; do
  case "$1" in
    --fuse) want_transport=fuse ;;
    --nfs) want_transport=nfs ;;
    --sudo) use_sudo=1 ;;
    --read-only) read_only=1 ;;
    --foreground) foreground=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; die "unknown argument: $1" ;;
  esac
  shift
done

load_config

transport="$(resolve_transport "$want_transport" "$(uname -s)")" || exit 1

# ---------------------------------------------------------------------------
# FUSE. Short, because there is no server to run and nothing to wait for: the
# process IS the mount. None of the NFS preflight below applies -- no docker, no
# mount.nfs, no root -- which is why this returns before reaching it.
#
# The remote already exists: httpeers-setup wrote it with `rclone config
# create`, and $HTTPEERS_TARGET is "<remote>:<bucket>". The cache and dir-cache
# flags match the ones the NFS container serves with, so a file behaves the same
# way whichever transport is mounted -- writes land through a cache, and a
# change made elsewhere shows up within ten seconds.
# ---------------------------------------------------------------------------
if [ "$transport" = "fuse" ]; then
  require_rclone
  TMPERR="$(mktemp)"; trap 'rm -f "$TMPERR"' EXIT
  rclone mount --help >/dev/null 2>&1 \
    || die "this rclone has no \`mount\` command. Use --nfs, or install a current rclone:
      curl https://rclone.org/install.sh | sudo bash"
  command -v fusermount3 >/dev/null 2>&1 || command -v fusermount >/dev/null 2>&1 \
    || die "fusermount is missing -- FUSE is not available on this host.
      Fix:  sudo apt install fuse3      (or mount with --nfs)"

  mnt="$HTTPEERS_MOUNT_POINT"
  mkdir -p "$mnt"
  if [ -n "$(mount_fs_at "$mnt")" ]; then
    info "already mounted at $mnt -- leaving it alone."
    exit 0
  fi

  # CHECK THE REMOTE BEFORE MOUNTING, not after. `rclone mount` does not contact
  # the remote to succeed: with bad credentials it mounts happily and every `ls`
  # afterwards fails with EIO, which looks like a broken disk rather than a
  # wrong key. The NFS path has its own version of this -- it waits for the port
  # and checks the container has not exited -- and FUSE needs one too.
  if ! rclone lsd "$HTTPEERS_TARGET" >/dev/null 2>"$TMPERR"; then
    err "cannot list $HTTPEERS_TARGET -- not mounting, because the mount would"
    err "appear to work and then fail on every read."
    sed 's/^/    /' "$TMPERR" >&2
    info ""
    info "    If the key is wrong or missing, re-run:  ./bin/httpeers-setup"
    exit 1
  fi

  [ "$read_only" = 1 ] && info "mounting READ-ONLY: writes to the mount will be refused."
  warn "there is no confirmation and no undo in this mode. Removing a directory here"
  warn "removes a live site immediately."
  cache_dir="${HTTPEERS_RUN_DIR:-.run}/fuse-cache"
  mkdir -p "$cache_dir"

  args=(mount "$HTTPEERS_TARGET" "$mnt"
        --vfs-cache-mode writes --dir-cache-time 10s --poll-interval 0
        --cache-dir "$cache_dir")
  [ "$read_only" = 1 ] && args+=(--read-only)
  if [ "$foreground" = 1 ]; then
    info "rclone ${args[*]}   (Ctrl-C to unmount)"
    exec rclone "${args[@]}"
  fi
  # `--daemon` RETURNS BEFORE THE MOUNT EXISTS. rclone forks, and the parent
  # exits 0 as soon as the child is running -- which is not the same thing as
  # the kernel having the mount. Reporting success there is a lie the next
  # command pays for: an unmount a few milliseconds later finds nothing to
  # unmount and fails. So wait for it to actually appear.
  args+=(--daemon)
  rclone "${args[@]}" || die "rclone mount failed."
  waited=0
  until mount_fs_at "$mnt" >/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 100 ] && die "rclone started but $mnt never became a mount point (waited 10s).
      Check:  rclone lsd $HTTPEERS_TARGET"
    sleep 0.1
  done
  info "mounted $HTTPEERS_TARGET at $mnt over FUSE (no root was needed)."
  info "Unmount with:  ./bin/httpeers-unmount"
  exit 0
fi

# ---------------------------------------------------------------------------
# Preflight. Every one of these fails on a stock Ubuntu 24.04 workstation, so
# it is the normal path, not the exceptional one -- and it must name the fix
# rather than half-starting something.
# ---------------------------------------------------------------------------
missing=0
# The NFS SERVER now runs in a container (docker-compose.yml beside this script),
# so the host's own rclone is irrelevant to this mode -- this machine's is
# v1.60.1-DEV and has no `serve nfs` at all, while the image pins v1.74.4 which
# does. What a container cannot supply is the CLIENT: mounting is a kernel
# operation on the host, so mount.nfs and root are still required out here.
if ! command -v docker >/dev/null 2>&1; then
  err "docker is not installed -- the NFS server runs as a container."
  info "    Fix:  https://docs.docker.com/engine/install/"
  missing=1
elif ! docker compose version >/dev/null 2>&1; then
  err "docker compose (v2) is not available."
  info "    Fix:  install the docker compose plugin"
  missing=1
fi
if ! have_mount_nfs; then
  err "mount.nfs is missing -- the NFS client utilities are not installed."
  info "    This one cannot be containerised: mounting happens in the host kernel."
  info "    Fix:  sudo apt install nfs-common"
  missing=1
fi
if [ "$missing" -ne 0 ]; then
  info ""
  info "Nothing was started. Run the commands above, then re-run this script,"
  info "or use sync mode instead, which needs neither:  httpeers-publish"
  exit 1
fi

addr="$HTTPEERS_NFS_ADDR"
host="${addr%:*}"
port="${addr##*:}"
mnt="$HTTPEERS_MOUNT_POINT"
run="$HTTPEERS_RUN_DIR"
pidfile="$run/serve-nfs.pid"
logfile="$run/serve-nfs.log"
mkdir -p "$run"

# ---------------------------------------------------------------------------
# The server -- a container.
#
# Credentials reach it as RCLONE_CONFIG_* environment variables rather than a
# config file, so nothing secret is written into this directory. The port is
# published on 127.0.0.1 only: an rclone NFS export is unauthenticated, and one
# reachable from the network would hand over the whole bucket.
# ---------------------------------------------------------------------------
compose_file="$PUBLISH_ROOT/docker-compose.yml"
[ -f "$compose_file" ] || die "missing $compose_file"

require_var() {
  [ -n "${!1:-}" ] || die "$1 is not set. Copy publish.env.example to publish.env and fill it in;
    the credentials are on the server:  ssh kotelnikov@163.172.46.87 'grep S3_ /opt/httpeers/.env'"
}
require_var HTTPEERS_S3_ACCESS_KEY_ID
require_var HTTPEERS_S3_SECRET_ACCESS_KEY

export HTTPEERS_NFS_PORT="$port"
export HTTPEERS_NFS_READ_ONLY=$([ "$read_only" = 1 ] && echo true || echo false)
[ "$read_only" = 1 ] && info "serving READ-ONLY: writes to the mount will be refused."
compose=(docker compose -f "$compose_file")

if [ "$foreground" = 1 ]; then
  info "${compose[*]} up nfs   (Ctrl-C to stop; the mount is not made in this mode)"
  exec "${compose[@]}" up nfs
fi

if [ "$("${compose[@]}" ps -q nfs 2>/dev/null | wc -l)" -gt 0 ] \
   && [ "$("${compose[@]}" ps --status running -q nfs 2>/dev/null | wc -l)" -gt 0 ]; then
  info "nfs server container already running on $addr"
else
  info "starting the nfs server container ..."
  "${compose[@]}" up -d nfs >/dev/null 2>&1 || {
    err "the nfs server container failed to start. Its output:"
    "${compose[@]}" logs --tail=30 nfs 2>&1 | sed 's/^/    /' >&2
    exit 1
  }
fi

# Wait for the port rather than for the container, and check the container is
# still alive each round: a server that exits on bad credentials would otherwise
# be discovered only by a mount error that says nothing about the cause.
ready=0
for _ in $(seq 1 40); do
  if [ "$("${compose[@]}" ps --status running -q nfs 2>/dev/null | wc -l)" -eq 0 ]; then
    err "the nfs server container exited. Its output:"
    "${compose[@]}" logs --tail=30 nfs 2>&1 | sed 's/^/    /' >&2
    exit 1
  fi
  if (echo > "/dev/tcp/$host/$port") 2>/dev/null; then ready=1; break; fi
  sleep 0.5
done
if [ "$ready" != 1 ]; then
  err "the nfs server is not accepting connections on $addr after 20s."
  "${compose[@]}" logs --tail=30 nfs 2>&1 | sed 's/^/    /' >&2
  exit 1
fi
info "nfs server listening on $addr (container httpeers_publish_nfs)"

# ---------------------------------------------------------------------------
# The mount
# ---------------------------------------------------------------------------
mkdir -p "$mnt"
if mountpoint -q "$mnt" 2>/dev/null || grep -qs " $mnt nfs" /proc/mounts; then
  info "$mnt is already mounted."
  exit 0
fi

# vers=3 because rclone's NFS server speaks NFSv3 only; nolock because there
# is no lock manager behind it and the kernel would otherwise block waiting
# for one that never answers.
mount_cmd=(mount -t nfs -o "port=$port,mountport=$port,tcp,vers=3,nolock,noatime" "$host:/" "$mnt")

if [ "$(id -u)" -ne 0 ] && [ "$use_sudo" != 1 ]; then
  info ""
  bold "the server is up. Mounting needs root -- run:"
  info ""
  info "    sudo ${mount_cmd[*]}"
  info ""
  info "or re-run this script with --sudo. To undo everything: httpeers-unmount"
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  info "+ sudo ${mount_cmd[*]}"
  sudo "${mount_cmd[@]}"
else
  info "+ ${mount_cmd[*]}"
  "${mount_cmd[@]}"
fi

info ""
bold "mounted: $mnt is the bucket."
warn "there is no confirmation and no undo in this mode. Removing a directory here"
warn "removes a live site immediately."
note "S3 has no real directories: an EMPTY directory you create here does not exist in"
note "the bucket and is not a site. A site begins to exist when the first file lands in"
note "it, and disappears when the last one is removed."
note "unmount with: httpeers-unmount"
