# Copy to `publish.env` beside this file and fill in the two S3 values.
#
#     cp publish.env.example publish.env
#
# `publish.env` is gitignored. Nothing in this directory may ever hold a real
# credential -- statewalker/httpeers is a public repository.

# ── Where the bucket is ────────────────────────────────────────────────────
# Caddy terminates TLS here and proxies to rustfs:9000. The store binds no
# host port, so this URL is the only way in from outside the server.
HTTPEERS_S3_ENDPOINT=https://s3.httpeers.net

# One first-level prefix per domain lives in this bucket.
HTTPEERS_S3_BUCKET=sites

# ── Credentials ────────────────────────────────────────────────────────────
# THESE EXIST IN EXACTLY ONE PLACE: /opt/httpeers/.env on the server, mode
# 600. They were generated there with `openssl rand` and have never left it;
# there is no other copy and no backup (runbook §2). Read them with:
#
#     ssh kotelnikov@163.172.46.87 'grep S3_ /opt/httpeers/.env'
#
# The same pair is used by the `sites` container over the docker network and
# by RustFS itself, so they cannot drift.
HTTPEERS_S3_ACCESS_KEY_ID=
HTTPEERS_S3_SECRET_ACCESS_KEY=

# ── Local layout ───────────────────────────────────────────────────────────
# The tree that mirrors the bucket. Each first-level directory is one site,
# named after its full domain:
#
#     sites/abc.httpeers.net/index.html
#     sites/abc.httpeers.net/.site/config.json     (optional, never served)
#     sites/cde.httpeers.net/index.html
#
# Relative paths are relative to tools/publish/.
HTTPEERS_SITES_DIR=./sites

# The name of the rclone remote httpeers-setup creates. Change it if you
# already have a remote called `httpeers` that belongs to something else --
# setup refuses to overwrite one it did not make.
HTTPEERS_RCLONE_REMOTE=httpeers

# ── Live (NFS) mode ────────────────────────────────────────────────────────
# Loopback only. Binding this to anything but 127.0.0.1 publishes an
# unauthenticated, writable view of every site to the network.
HTTPEERS_NFS_ADDR=127.0.0.1:20490
HTTPEERS_MOUNT_POINT=./mnt

# Pidfile and server log for the NFS mode.
HTTPEERS_RUN_DIR=./.run

# ── Testing ────────────────────────────────────────────────────────────────
# Replaces the entire rclone destination, bypassing the remote and the
# credentials. rclone treats a plain directory as a remote, so setting this to
# a local path exercises the real code against a fake bucket. tests/run-tests.sh
# uses it. Leave it unset for anything else.
# HTTPEERS_TARGET_OVERRIDE=
