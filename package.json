{
  "name": "@statewalker/httpeers-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "httpeers — the mesh's deployable services. Monorepo.",
  "bugs": {
    "url": "https://github.com/statewalker/httpeers/issues"
  },
  "homepage": "https://github.com/statewalker/httpeers#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/httpeers.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:nightly": "r=0; pnpm --filter @statewalker/httpeers-browser-conformance run test:browser || r=1; pnpm --filter @statewalker/httpeers-share run test:e2e || r=1; pnpm --filter @statewalker/httpeers-hub-daemon run test:ui || r=1; pnpm --filter @statewalker/webrun-biscuit run test:cross || r=1; exit $r",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": ""
}
