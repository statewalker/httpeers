{
  "name": "@statewalker/httpeers-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "description": "httpeers \u2014 the mesh's deployable services. Monorepo.",
  "homepage": "https://github.com/statewalker/httpeers",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": "",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@statewalker/webrun-streams": "link:../webrun-wire/packages/webrun-streams",
      "@statewalker/webrun-streams-libp2p": "link:../webrun-wire/packages/webrun-streams-libp2p",
      "@statewalker/webrun-http-streams": "link:../webrun-wire/packages/webrun-http-streams"
    }
  }
}
