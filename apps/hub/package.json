{
  "name": "@statewalker/httpeers-hub-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Node hub daemon: persistent identity, state and rules, built-in service modules, and a local door.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git",
    "directory": "apps/hub"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:check": "biome check src tests"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@hono/node-server": "2.1.1",
    "@libp2p/circuit-relay-v2": "4.2.11",
    "@libp2p/identify": "4.1.12",
    "@libp2p/interface": "3.2.5",
    "@libp2p/webrtc": "6.0.29",
    "@libp2p/websockets": "10.1.19",
    "@statewalker/httpeers-access": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/httpeers-hub": "workspace:*",
    "@statewalker/httpeers-libp2p": "workspace:*",
    "@statewalker/httpeers-member": "workspace:*",
    "@statewalker/webrun-http-proxy": "^0.1.0",
    "libp2p": "3.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@libp2p/crypto": "5.1.22",
    "@statewalker/httpeers-relay": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
