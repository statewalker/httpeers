    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@hono/node-server": "catalog:",
    "@statewalker/webrun-files": "catalog:",
