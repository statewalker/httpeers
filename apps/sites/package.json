{
  "name": "@statewalker/httpeers-sites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site host — one site per storage prefix, named after its domain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/httpeers.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@hono/node-server": "2.1.1",
    "@statewalker/webrun-files": "0.7.0",
    "@statewalker/webrun-files-mem": "0.7.2",
    "@statewalker/webrun-files-node": "0.7.0",
    "@statewalker/webrun-files-s3": "0.7.0",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
