    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@statewalker/httpeers-access": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/httpeers-join": "workspace:*",
    "@statewalker/httpeers-member": "workspace:*",
    "@statewalker/shared-slots": "catalog:",
    "@statewalker/webrun-http-browser": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
