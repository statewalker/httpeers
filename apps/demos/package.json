{
  "name": "@statewalker/httpeers-demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The four demo sites — hub, app, images and proxy — built on the extracted libraries.",
  "scripts": {
    "build": "pnpm run build:hub && pnpm run build:images && pnpm run build:app && pnpm run build:proxy",
    "build:hub": "node scripts/copy-assets.mjs && vite build --config vite.hub.config.ts",
    "dev:hub": "node scripts/copy-assets.mjs && vite --config vite.hub.config.ts",
    "test": "echo \"no unit tests: the demos are exercised by httpeers-browser-conformance\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:check": "biome check src",
    "prebuild": "node scripts/copy-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:images": "node scripts/copy-assets.mjs && vite build --config vite.images.config.ts",
    "dev:images": "node scripts/copy-assets.mjs && vite --config vite.images.config.ts",
    "build:app": "node scripts/copy-assets.mjs && vite build --config vite.app.config.ts",
    "dev:app": "node scripts/copy-assets.mjs && vite --config vite.app.config.ts",
    "build:proxy": "node scripts/copy-assets.mjs && vite build --config vite.proxy.config.ts",
    "dev:proxy": "node scripts/copy-assets.mjs && vite --config vite.proxy.config.ts"
  },
  "dependencies": {
    "@biscuit-auth/biscuit-wasm": "0.6.0",
    "@libp2p/interface": "3.2.5",
    "@statewalker/httpeers-access": "workspace:*",
    "@statewalker/httpeers-bridge": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/httpeers-hub": "workspace:*",
    "@statewalker/httpeers-libp2p": "workspace:*",
    "@statewalker/httpeers-member": "workspace:*",
    "@statewalker/httpeers-qr": "workspace:*",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-http-browser": "workspace:*",
    "@statewalker/webrun-http-proxy": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  }
}
