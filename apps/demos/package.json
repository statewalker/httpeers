{
  "name": "@statewalker/httpeers-demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The four demo sites \u2014 hub, app, images and proxy \u2014 built on the extracted libraries.",
  "scripts": {
    "build": "pnpm run build:hub",
    "build:hub": "node scripts/copy-assets.mjs && vite build --config vite.hub.config.ts",
    "dev:hub": "node scripts/copy-assets.mjs && vite --config vite.hub.config.ts",
    "test": "echo \"no unit tests: the demos are exercised by httpeers-browser-conformance\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:check": "biome check src",
    "prebuild": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@biscuit-auth/biscuit-wasm": "0.6.0",
    "@libp2p/interface": "3.2.5",
    "@statewalker/httpeers-access": "workspace:*",
    "@statewalker/httpeers-bridge": "workspace:*",
    "@statewalker/httpeers-core": "workspace:*",
    "@statewalker/httpeers-hub": "workspace:*",
    "@statewalker/httpeers-libp2p": "workspace:*",
    "@statewalker/httpeers-member": "workspace:*",
    "@statewalker/httpeers-qr": "workspace:*",
    "@statewalker/webrun-http-browser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0"
  }
}
