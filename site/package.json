{
  "name": "@statewalker/httpeers-site",
  "private": true,
  "type": "module",
  "description": "The httpeers website (Astro, Tailwind CSS, shadcn/ui tokens), with live examples of the libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/httpeers.git",
    "directory": "site"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/compress.mjs",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@statewalker/httpeers-access": "workspace:^",
    "@statewalker/httpeers-bridge": "workspace:^",
    "@statewalker/httpeers-core": "workspace:^",
    "@statewalker/httpeers-hub": "workspace:^",
    "@statewalker/httpeers-qr": "workspace:^",
    "@statewalker/webrun-biscuit": "workspace:^",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
