---
import Button from "@/components/ui/Button.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Not found · httpeers">
  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-primary">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">No handler is mounted here</h1>
    <p class="mt-3 text-muted-foreground">The page you asked for does not exist on this site.</p>
    <div class="mt-6 flex justify-center gap-3">
      <Button href="/">Home</Button>
      <Button href="/docs" variant="outline">Docs</Button>
    </div>
  </section>
</Base>
