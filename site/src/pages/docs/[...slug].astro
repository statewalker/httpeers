---
import { getEntry, render } from "astro:content";
import Docs from "@/layouts/Docs.astro";
import { type RepoPage, relatedPages, repoPages } from "@/lib/docs";
import { repoFile } from "@/lib/site";

export function getStaticPaths() {
  return repoPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

/** The page's meta description: its first paragraph of prose, as plain text, cut to ~160 chars. */
function describe(markdown: string): string | undefined {
  const block = markdown
    .split(/\n\s*\n/)
    .map((b) => b.trim())
    .find((b) => b && !/^(#|```|\||<|>|-|\*\s|!|\[|\d+\.)/.test(b));
  if (!block) return undefined;
  const text = block
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/<(https?:[^>]+)>/g, "$1")
    .replace(/`|\*\*|__/g, "")
    .replace(/\s+/g, " ")
    .trim();
  if (text.length <= 160) return text.replace(/:$/, ".");
  const cut = text.slice(0, 159);
  return `${cut.slice(0, cut.lastIndexOf(" ")).replace(/[,;:.]$/, "")}…`;
}

const { page } = Astro.props as { page: RepoPage };
const entry = await getEntry("repo", page.file);
if (!entry) throw new Error(`${page.file} is not in the "repo" collection`);
const { Content } = await render(entry);
const description = describe(entry.body ?? "");
const related = relatedPages[page.file] ?? [];
---

<Docs title={page.label} description={description}>
  {
    related.length > 0 && (
      <aside class="not-prose mb-8 rounded-xl border bg-muted/40 p-4 text-sm">
        <p class="font-medium">On this site</p>
        <ul class="mt-2 space-y-1">
          {related.map((r) => (
            <li>
              <a href={r.href} class="text-primary underline-offset-4 hover:underline">
                {r.label}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
  <Content />
  <p class="mt-10 text-sm text-muted-foreground">
    This page is <a href={repoFile(page.file)}>{page.file}</a> in the repository, rendered at build time.
  </p>
</Docs>
