# Copy to .env beside this file. Never commit .env -- it holds a DNS-write
# credential and, optionally, the relay's identity.

# ── Certificates ──────────────────────────────────────────────────────────
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=admin@httpeers.net

# A Gandi PERSONAL ACCESS TOKEN, not an API key: Gandi discontinued API Key
# auth and the caddy-dns/gandi module does not accept one.
#
# Scope it to managing DNS records in this zone and nothing else. A token that
# can also delete the zone or edit A records turns a proxy compromise into a
# domain compromise.
GANDI_BEARER_TOKEN=

# ── Relay ─────────────────────────────────────────────────────────────────
# The address peers dial, which behind the proxy is not the address the relay
# binds. /tls/ws, not the legacy /wss.
RELAY_ANNOUNCE_ADDRS=/dns4/relay.httpeers.net/tcp/443/tls/ws

# Optional. Seeds the relay's identity onto an empty volume, for reproducing
# this deployment elsewhere. IGNORED once the volume holds a key, so a stale
# value here can never silently replace a working identity.
#
# Generate one with:
#   pnpm --filter @statewalker/httpeers-relay bootstrap
RELAY_KEY=
